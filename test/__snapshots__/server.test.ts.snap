            "enum": [
              "frontpage",
              "recent_discussion",
              "popular_comments",
              "quick_takes",
              "this_week",
              "wiki_activity",
              "dialogues",
              "best_of",
              "spotlight",
            ],
            "type": "string",
          },
          "limit": {
            "default": 10,
            "maximum": 50,
            "minimum": 1,
            "type": "integer",
          },
          "max_tokens": {
            "default": 15000,
            "maximum": 40000,
            "minimum": 2000,
            "type": "integer",
          },
          "sort": {
            "default": "new",
            "enum": [
